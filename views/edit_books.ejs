<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css" />
    <title>Edita Llibre</title>
</head>
<body>
    <header>
        <h1>Editar Llibre: <%= book.name %></h1>
    </header>

    <main>
        <form action="/books/<%= book.id %>?_method=PUT" method="POST">
            <label for="name">Titol:</label>
            <input type="text" id="name" name="name" value="<%= book.name %>" required>

            <label for="author">Autor:</label>
            <input type="text" id="author" name="author" value="<%= book.author %>" required>

            <label for="year">Año:</label>
            <input type="number" id="year" name="year" value="<%= book.year %>" required>

            <button type="submit">Guardar Cambios</button>
        </form>
        <a href="/books">Volver a listado</a>
    </main>
</body>
</html>