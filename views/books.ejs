<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css" />
    <title>Llibres</title>
</head>
<body>
    <div class="page">
    <h1>Lista de libros</h1>

    <% if (books.length === 0) { %>
        <p>No hi ha llibres.</p>
    <% } else { %>
        <ul class="list">
            <% books.forEach(book => { %>
                <li class="card">
                    <div class="info">
                        <div class="name"><%= book.name %></div>
                        <div class="detail"><%= book.author %> · <%= book.year %></div>
                    </div>

                    <div class="actions">
                        <a class="btn btn-small" href="/books/<%= book.id %>/edit">Editar</a>

                        <!-- onsubmit: confirm() shows the alert; Cancel -> false -> the form is NOT sent -->
                        <form action="/books/<%= book.id %>?_method=DELETE" method="POST"
                              onsubmit="return confirm('¿Seguro que quieres eliminar este libro?')">
                            <button type="submit" class="btn-small">Eliminar</button>
                        </form>
                    </div>
                </li>
            <% }) %>
        </ul>
    <% } %>
    <a class="back" href="/protected">Volver</a>
    </div>
</body>
</html>
